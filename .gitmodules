[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "CEACT"]
	path = CEACT
	url = https://github.com/ielbadisy/ceact
[submodule "densemlp"]
	path = densemlp
	url = https://github.com/ielbadisy/densemlp
